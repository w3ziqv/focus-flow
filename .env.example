# Focus Flow — Firebase Cloud Sync Configuration Template
# Copy this file to .env.local and populate with your Firebase Web App credentials.
# Without these variables, Focus Flow operates 100% locally with zero cloud network calls.

VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
