; Tauri-specific NSIS messages; standard installer screens use NSIS Polish.nlf.
LangString addOrReinstall ${LANG_POLISH} "Dodaj lub zainstaluj ponownie składniki"
LangString alreadyInstalled ${LANG_POLISH} "Aplikacja jest już zainstalowana"
LangString alreadyInstalledLong ${LANG_POLISH} "${PRODUCTNAME} ${VERSION} jest już zainstalowany. Wybierz działanie i kliknij Dalej."
LangString appRunning ${LANG_POLISH} "{{product_name}} jest uruchomiony. Zamknij aplikację i spróbuj ponownie."
LangString appRunningOkKill ${LANG_POLISH} "{{product_name}} jest uruchomiony.$\nKliknij OK, aby zakończyć jego proces."
LangString chooseMaintenanceOption ${LANG_POLISH} "Wybierz działanie dotyczące istniejącej instalacji."
LangString chooseHowToInstall ${LANG_POLISH} "Wybierz sposób instalacji ${PRODUCTNAME}."
LangString createDesktop ${LANG_POLISH} "Utwórz skrót na pulpicie"
LangString dontUninstall ${LANG_POLISH} "Nie odinstalowuj"
LangString dontUninstallDowngrade ${LANG_POLISH} "Nie odinstalowuj (ten instalator nie pozwala zainstalować starszej wersji bez odinstalowania obecnej)"
LangString failedToKillApp ${LANG_POLISH} "Nie udało się zakończyć procesu {{product_name}}. Zamknij aplikację i spróbuj ponownie."
LangString installingWebview2 ${LANG_POLISH} "Instalowanie WebView2…"
LangString newerVersionInstalled ${LANG_POLISH} "Nowsza wersja ${PRODUCTNAME} jest już zainstalowana. Przed instalacją starszej wersji zalecane jest odinstalowanie obecnej. Wybierz działanie i kliknij Dalej."
LangString older ${LANG_POLISH} "starsza"
LangString olderOrUnknownVersionInstalled ${LANG_POLISH} "W systemie jest zainstalowana wersja ${PRODUCTNAME} ($R4). Przed instalacją zalecane jest odinstalowanie obecnej wersji. Wybierz działanie i kliknij Dalej."
LangString silentDowngrades ${LANG_POLISH} "Ten instalator nie pozwala na instalację starszej wersji w trybie cichym. Użyj interfejsu graficznego.$\n"
LangString unableToUninstall ${LANG_POLISH} "Nie udało się odinstalować aplikacji."
LangString uninstallApp ${LANG_POLISH} "Odinstaluj ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_POLISH} "Odinstaluj przed instalacją"
LangString unknown ${LANG_POLISH} "nieznana"
LangString webview2AbortError ${LANG_POLISH} "Nie udało się zainstalować WebView2. Aplikacja wymaga tego składnika. Uruchom instalator ponownie."
LangString webview2DownloadError ${LANG_POLISH} "Nie udało się pobrać WebView2: $0"
LangString webview2DownloadSuccess ${LANG_POLISH} "Pobrano instalator WebView2"
LangString webview2Downloading ${LANG_POLISH} "Pobieranie instalatora WebView2…"
LangString webview2InstallError ${LANG_POLISH} "Instalacja WebView2 nie powiodła się. Kod zakończenia: $1"
LangString webview2InstallSuccess ${LANG_POLISH} "Zainstalowano WebView2"
LangString deleteAppData ${LANG_POLISH} "Usuń dane aplikacji"
