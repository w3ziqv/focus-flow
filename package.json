{
  "name": "focus-flow",
  "description": "A quiet Pomodoro focus timer with ambient sound, stats, and a warm editorial interface.",
  "private": true,
  "version": "3.1.2",
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27",
    "npm": ">=12.2.2 <13"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:node": "npm run typecheck",
    "lint": "eslint .",
    "design:tokens": "node scripts/design-tokens.mjs",
    "design:check": "node scripts/design-tokens.mjs --check",
    "test": "vitest",
    "test:run": "vitest run --exclude \"**/*.emulator.test.ts\"",
    "test:integration": "node scripts/test-integration.mjs",
    "test:a11y": "node scripts/test-accessibility.mjs",
    "measure:browser": "node scripts/measure-performance.mjs",
    "measure:history": "node scripts/measure-history.mjs",
    "measure:ui": "node scripts/measure-ui-renders.mjs",
    "test:ui-boundaries": "node --test scripts/test-ui-boundaries.mjs",
    "test:ui-interactions": "node scripts/test-ui-interactions.mjs",
    "dev:desktop": "vite --mode desktop",
    "build:desktop": "tsc --noEmit && vite build --mode desktop",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "verify:builds": "node scripts/verify-builds.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:web-offline": "node scripts/test-web-offline.mjs",
    "test:rules": "node scripts/test-firestore-rules.mjs",
    "test:migration": "node scripts/test-migration.mjs",
    "test:localization": "node scripts/test-localization.mjs",
    "test:responsive": "node scripts/test-responsive.mjs",
    "test:security": "vitest run src/lib/security.test.ts src/lib/security_stress.test.ts src/lib/import_atomicity.test.ts src/lib/export_security.test.ts src/lib/desktop/peer_transfer.test.ts",
    "test:stress": "node scripts/test-security-browser.mjs",
    "test:guides": "node scripts/test-guides-interface.mjs",
    "test:motion": "node scripts/test-motion.mjs",
    "test:toolchain": "node --test scripts/test-toolchain.mjs",
    "test:dependency-migration": "node scripts/test-dependency-migration.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "firebase": "^13.2.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "playwright-core": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@firebase/util": false,
    "protobufjs": false,
    "fsevents": false
  },
  "packageManager": "npm@12.2.2",
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
