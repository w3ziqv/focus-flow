{
  "name": "focus-flow",
  "description": "A quiet Pomodoro focus timer with ambient sound, stats, and a warm editorial interface.",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:node": "npx --package=typescript@5.8 tsc --noEmit",
    "lint": "eslint .",
    "design:tokens": "node scripts/design-tokens.mjs",
    "design:check": "node scripts/design-tokens.mjs --check",
    "test": "vitest",
    "test:run": "vitest run --exclude \"**/*.emulator.test.ts\"",
    "test:integration": "node scripts/test-integration.mjs",
    "test:a11y": "node scripts/test-accessibility.mjs",
    "measure:browser": "node scripts/measure-performance.mjs",
    "measure:history": "node scripts/measure-history.mjs",
    "measure:ui": "node scripts/measure-ui-renders.mjs",
    "test:ui-boundaries": "node --test scripts/test-ui-boundaries.mjs",
    "test:ui-interactions": "node scripts/test-ui-interactions.mjs",
    "dev:desktop": "vite --mode desktop",
    "build:desktop": "tsc --noEmit && vite build --mode desktop",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "verify:builds": "node scripts/verify-builds.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:web-offline": "node scripts/test-web-offline.mjs",
    "test:rules": "node scripts/test-firestore-rules.mjs",
    "test:migration": "node scripts/test-migration.mjs",
    "test:localization": "node scripts/test-localization.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.5",
    "@fontsource-variable/instrument-sans": "^5.2.5",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-notification": "^2.5.1",
    "firebase": "^12.19.0",
    "lucide-react": "^0.539.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@tailwindcss/vite": "^4.1.11",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.1",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
